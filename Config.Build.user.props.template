<Project>

  <PropertyGroup>
    <!-- Set if the default steam game install directory doesn't work. -->
    <!-- <GloomwoodGameRootDir></GloomwoodGameRootDir> -->
    <!-- Set if your BepInEx/plugins/ directory isn't in the game files. -->
    <!-- <GloomwoodPluginsDir></GloomwoodPluginsDir> -->
  </PropertyGroup>

    <Target Name="CopyMissingDependencies" AfterTargets="Build">
        <ItemGroup>
            <ButtplugFiles Include="$(NuGetPackageRoot)/buttplug/4.0.0/lib/netstandard2.1/*.dll" />
            <NewtonsoftFiles Include="$(NuGetPackageRoot)/newtonsoft.json/13.0.4/lib/netstandard2.0/*.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(ButtplugFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(NewtonsoftFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    </Target>

  <Target Name="DeployFiles" AfterTargets="Build">
    <Message Text="Deploy → $(GloomwoodPluginsDir)$(AssemblyName).dll" Importance="High" />
    <Error
      Text="Plugins directory '$([MSBuild]::NormalizeDirectory($(GloomwoodPluginsDir)))' doesn't exist! Configure GloomwoodPluginsDir to point to a valid path in the Config.Build.user.props file."
      Condition="!Exists('$(GloomwoodPluginsDir)')"
    />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GloomwoodPluginsDir)" />
  </Target>

</Project>
